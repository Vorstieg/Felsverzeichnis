{
	"name": "Felsverzeichnis",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "pwuser",
	"updateRemoteUserUID": false,
	"postCreateCommand": "sudo chown -R pwuser:pwuser node_modules && npm ci",
	"features": {
		"ghcr.io/coder/devcontainer-features/code-server:2": {
			"version": "4.121.0",
			"host": "0.0.0.0",
			"port": "8080",
			"auth": "password",
			"workspace": "/workspaces/Felsverzeichnis",
			"disableTelemetry": true,
			"disableUpdateCheck": true,
			"extensions": "svelte.svelte-vscode,dbaeumer.vscode-eslint,esbenp.prettier-vscode"
		}
	},
	"mounts": ["source=felsverzeichnis-node_modules,target=/workspaces/Felsverzeichnis/node_modules,type=volume"],
	"appPort": ["127.0.0.1:8080:8080"],
	"forwardPorts": [8080, 5173],
	"portsAttributes": {
		"8080": {
			"label": "code-server",
			"onAutoForward": "openBrowser"
		},
		"5173": {
			"label": "Vite development server",
			"onAutoForward": "openBrowser"
		}
	}
}
